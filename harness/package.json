{
  "name": "cadre-ai",
  "version": "3.0.2",
  "description": "Cross-agent, human-governed software delivery harness",
  "author": {
    "name": "Vishal Kumar",
    "url": "https://github.com/vishal-kr-barnwal"
  },
  "homepage": "https://cadre-docs.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishal-kr-barnwal/cadre.git",
    "directory": "harness"
  },
  "license": "MIT",
  "keywords": [
    "cadre",
    "cadre-ai",
    "agent-workflows",
    "mcp",
    "codex",
    "claude"
  ],
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "bin": {
    "cadre-ai": "dist/cadre-cli.mjs"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".mcp.codex.json",
    ".mcp.json",
    "agents/",
    "dist/",
    "LICENSE",
    "marketplace/",
    "README.md",
    "skills/",
    "templates/"
  ],
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "install:plugin": "pnpm build && node dist/cadre-cli.mjs install --target all",
    "prepack": "pnpm build && node --import tsx scripts/validate.ts",
    "test": "pnpm build && node --import tsx --test test/*.test.ts",
    "validate": "pnpm build && node --import tsx scripts/validate.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
