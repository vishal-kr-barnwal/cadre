{
  "name": "cadre-agent-harness",
  "version": "0.3.0",
  "private": true,
  "description": "Cross-agent, human-governed software delivery harness",
  "type": "module",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "install:plugin": "node --import tsx scripts/install.ts --agent all",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "validate": "npm run build && node --import tsx scripts/validate.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
