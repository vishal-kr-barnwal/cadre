{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-revise",
  "workflow": "revise",
  "inputs": [
    "trackId",
    "reason",
    "spec?",
    "plan?"
  ],
  "transitions": [
    "clarify",
    "review_revision",
    "execute"
  ],
  "approval": "document_staged",
  "references": [
    {
      "id": "native-prompts",
      "when": "decision:clarification"
    },
    {
      "id": "approval-and-generation",
      "when": "decision:approval"
    }
  ]
}
