{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-newtrack",
  "workflow": "newtrack",
  "inputs": [
    "trackId",
    "spec",
    "plan"
  ],
  "transitions": [
    "clarify",
    "review_spec_plan",
    "execute"
  ],
  "approval": "staged",
  "references": [
    {
      "id": "native-prompts",
      "when": "decision:clarification"
    },
    {
      "id": "approval-and-generation",
      "when": "decision:approval"
    }
  ]
}
