{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-implement",
  "workflow": "implement",
  "inputs": [
    "trackId?",
    "phaseIndex?",
    "taskIndex?"
  ],
  "transitions": [
    "select_ready_task",
    "apply_project_rules",
    "execute",
    "complete_task"
  ],
  "approval": "execute",
  "references": [
    {
      "id": "parallel-execution",
      "when": "next.arguments.action startsWith 'parallel.' or data.workers[].dispatch.record_finish_packet exists or data.worker_callbacks[].record_finish_packet exists"
    },
    {
      "id": "ownership-guard",
      "when": "decision:ownership_conflict"
    }
  ]
}
