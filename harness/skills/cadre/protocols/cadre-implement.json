{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-implement",
  "workflow": "implement",
  "inputs": [
    "trackId?",
    "phaseIndex?",
    "taskIndex?"
  ],
  "transitions": [
    "select_ready_task",
    "apply_project_rules",
    "execute",
    "complete_task"
  ],
  "approval": "execute",
  "references": [
    {
      "id": "parallel-execution",
      "when": "next:parallel.*"
    },
    {
      "id": "ownership-guard",
      "when": "decision:ownership_conflict"
    }
  ]
}
