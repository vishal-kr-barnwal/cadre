{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-setup",
  "workflow": "setup",
  "inputs": [
    "product",
    "productGuidelines",
    "techStack",
    "workflowPolicy"
  ],
  "transitions": [
    "collect_product",
    "review_product",
    "collect_product_guidelines",
    "review_product_guidelines",
    "collect_technical_context",
    "review_grouped_technical_context",
    "collect_workflow_policy",
    "review_workflow_policy",
    "execute"
  ],
  "approval": "document_staged",
  "references": [
    {
      "id": "native-prompts",
      "when": "decision:clarification"
    },
    {
      "id": "template-locator",
      "when": "resources:template"
    },
    {
      "id": "approval-and-generation",
      "when": "decision:approval"
    }
  ]
}
