{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-formula",
  "workflow": "formula",
  "inputs": [
    "operation",
    "formulaId?",
    "variables?"
  ],
  "transitions": [
    "run_operation",
    "collect_and_review_pour_spec_if_needed",
    "collect_and_review_pour_plan_if_needed",
    "execute",
    "summarize"
  ],
  "approval": "document_staged_for_pour_execute_for_other_mutations",
  "references": [
    { "id": "approval-and-generation", "when": "operation:pour and decision:approval" }
  ]
}
