{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-refresh",
  "workflow": "refresh",
  "inputs": [
    "refreshLevels?",
    "reason?",
    "detectedChanges?",
    "proposedContext?"
  ],
  "transitions": [
    "analyze",
    "select_levels",
    "collect_and_review_only_active_stage",
    "repeat_selected_stages_in_order_product_product_guidelines_grouped_technical_workflow_patterns",
    "execute"
  ],
  "approval": "document_staged_for_selected_semantic_levels",
  "references": [
    {
      "id": "native-prompts",
      "when": "decision:clarification"
    },
    {
      "id": "approval-and-generation",
      "when": "decision:approval"
    }
  ]
}
