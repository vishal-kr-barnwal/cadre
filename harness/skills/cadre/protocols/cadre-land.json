{
  "version": 1,
  "schema": "cadre.protocol.v1",
  "id": "cadre-land",
  "workflow": "land",
  "inputs": [
    "trackId",
    "providerEvidence?"
  ],
  "transitions": [
    "check_repos",
    "prepare_provider",
    "execute"
  ],
  "approval": "execute",
  "references": [
    {
      "id": "provider-evidence",
      "when": "phase:pending_provider"
    },
    {
      "id": "polyrepo-git",
      "when": "always"
    }
  ]
}
