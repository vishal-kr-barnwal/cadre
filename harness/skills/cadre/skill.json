{
  "version": 1,
  "schema": "cadre.skill.v1",
  "id": "cadre",
  "name": "Cadre",
  "activation": {
    "tool": "cadre_workflow",
    "arguments": ["root", "workflow", "input", "execute", "approval"],
    "protocol_reads_required": false
  },
  "invariants": [
    "Cadre packets own control-plane, provider, worker, approval, merge, and generated projection state",
    "Markdown projections are never canonical input",
    "Only explicit user approval may be mapped into approval fields",
    "Required project-skill rules are never truncated"
  ],
  "workflows": [
    "setup",
    "newtrack",
    "implement",
    "debug",
    "status",
    "validate",
    "flag",
    "revise",
    "review",
    "ship",
    "land",
    "handoff",
    "archive",
    "release",
    "refresh",
    "revert",
    "formula",
    "artifacts"
  ],
  "references": [
    { "id": "native-prompts", "when": "decision.kind == 'clarification'" },
    { "id": "approval-and-generation", "when": "decision.kind == 'approval'" },
    { "id": "provider-evidence", "when": "phase == 'pending_provider'" },
    { "id": "parallel-execution", "when": "next.action startsWith 'parallel.'" },
    { "id": "ownership-guard", "when": "decision.kind == 'ownership_conflict'" },
    { "id": "polyrepo-git", "when": "workflow == 'land'" },
    { "id": "template-locator", "when": "workflow in ['setup','artifacts'] and a template resource is returned" }
  ]
}
